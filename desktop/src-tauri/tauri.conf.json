{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quartz",
  "version": "0.1.0",
  "identifier": "uk.sigint-pm.quartz",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../../web run dev",
    "beforeBuildCommand": "npm --prefix ../../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "quartz",
        "width": 1040,
        "height": 720,
        "minWidth": 420,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
