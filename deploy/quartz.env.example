# /opt/quartz/.env — mode 600, owner sigint. Secrets live only here.
QUARTZ_ADDR=127.0.0.1:8086
QUARTZ_VAULT=/srv/quartz/vault
QUARTZ_INDEX=/srv/quartz/index.sqlite
QUARTZ_WEB_DIR=/opt/quartz/web
QUARTZ_USER=juli
# Generate with: quartz-passwd
QUARTZ_PASSWORD_HASH=
QUARTZ_SECURE_COOKIE=true
QUARTZ_SESSION_TTL_DAYS=90
QUARTZ_GIT=true
QUARTZ_GIT_DEBOUNCE_SECONDS=30
QUARTZ_MAX_FILE_MB=64
