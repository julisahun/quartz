[Unit]
Description=quartz notes server
Documentation=https://github.com/julisahun/quartz
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sigint
Group=sigint
WorkingDirectory=/opt/quartz
EnvironmentFile=/opt/quartz/.env
ExecStart=/opt/quartz/quartz
Restart=on-failure
RestartSec=3

# The vault is the only thing this service may write.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/quartz /opt/quartz

[Install]
WantedBy=multi-user.target
