# /opt/quarts/.env — mode 600, owner sigint. Secrets live only here.
QUARTS_ADDR=127.0.0.1:8086
QUARTS_VAULT=/srv/quarts/vault
QUARTS_INDEX=/srv/quarts/index.sqlite
QUARTS_WEB_DIR=/opt/quarts/web
QUARTS_USER=juli
# Generate with: quarts-passwd
QUARTS_PASSWORD_HASH=
QUARTS_SECURE_COOKIE=true
QUARTS_SESSION_TTL_DAYS=90
QUARTS_GIT=true
QUARTS_GIT_DEBOUNCE_SECONDS=30
QUARTS_MAX_FILE_MB=64
