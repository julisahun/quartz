[Unit]
Description=quarts notes server
Documentation=https://github.com/julisahun/quarts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sigint
Group=sigint
WorkingDirectory=/opt/quarts
EnvironmentFile=/opt/quarts/.env
ExecStart=/opt/quarts/quarts
Restart=on-failure
RestartSec=3

# The vault is the only thing this service may write.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/srv/quarts /opt/quarts

[Install]
WantedBy=multi-user.target
